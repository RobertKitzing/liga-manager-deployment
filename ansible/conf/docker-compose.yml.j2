services:
  api:
    image: mklocke/liga-manager-api:{{versions.api}}
    restart: always
    volumes:
      - logos:/var/www/logos
    depends_on:
      mariadb:
        condition: service_healthy
      redis:
        condition: service_healthy
    env_file:
      - ./api.env
    healthcheck:
      test: [ "CMD", "docker-php-healthcheck", "http", "127.0.0.1", "8080" ]
      start_period: 1m
      start_interval: 5s
      interval: 1m
      timeout: 5s
  mariadb:
    image: mariadb:{{versions.mariadb}}
    restart: always
    ports:
      - "127.0.0.1:3306:3306"
    volumes:
      - mariadb:/var/lib/mysql
    #  - ./setup.sql:/docker-entrypoint-initdb.d/setup.sql:ro
    #environment:
    #  - MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=1
    healthcheck:
      test: [ "CMD", "healthcheck.sh", "--connect", "--innodb_initialized" ]
      start_period: 1m
      start_interval: 5s
      interval: 1m
      timeout: 5s
  nginx:
    build:
      dockerfile_inline: |
        FROM robertkitzing/liga-manager-ui:{{versions.ui}} as source
        FROM nginx:{{versions.nginx}}
        COPY --from=source /usr/src/app/www /var/www/ui
    restart: always
    ports:
      - "80:80/tcp"
      - "443:443/tcp"
      - "443:443/udp"
    volumes:
      - ./nginx-ssl.conf:/etc/nginx/conf.d/default.conf
      - certs:/etc/letsencrypt
      - wp-files:/var/www/html
      - logos:/var/www/logos:ro
      - ./appsettings.json:/var/www/ui/appsettings.json:ro
    depends_on:
      - api
      - wordpress
    env_file:
      - ./ui.env
  wordpress:
    image: wordpress:{{versions.wordpress}}
    restart: always
    volumes:
      - wp-files:/var/www/html
      - ./php.ini:/usr/local/etc/php/php.ini:ro
      - ./sendmail.sh:/usr/local/bin/sendmail:ro
    env_file:
      - ./wordpress.env
    depends_on:
      - mariadb
  redis:
    image: redis:{{versions.redis}}
    restart: always
    ports:
      - "127.0.0.1:6379:6379"
    healthcheck:
      test: [ "CMD", "redis-cli", "PING" ]
      start_period: 1m
      start_interval: 5s
      interval: 1m
      timeout: 5s

volumes:
  mariadb:
  wp-files:
  certs:
  logos: