ALTER USER 'root'@'localhost' IDENTIFIED VIA unix_socket;
ALTER USER 'root'@'%' IDENTIFIED BY '{{db_passwords.root}}';

CREATE DATABASE IF NOT EXISTS lima;
CREATE USER IF NOT EXISTS {{db_users.lima}}@'%' IDENTIFIED BY '{{db_passwords.lima}}';
GRANT ALL PRIVILEGES ON lima.* TO {{db_users.lima}}@'%';

CREATE DATABASE IF NOT EXISTS wordpress;
CREATE USER IF NOT EXISTS {{db_users.wordpress}}@'%' IDENTIFIED BY '{{db_passwords.wordpress}}';
GRANT ALL PRIVILEGES ON wordpress.* TO {{db_users.wordpress}}@'%';

CREATE USER {{db_users.exporter}}@'%' IDENTIFIED BY '{{db_passwords.exporter}}' WITH MAX_USER_CONNECTIONS 3;
GRANT SELECT, PROCESS, REPLICATION CLIENT ON *.* TO 'exporter'@'%';

FLUSH PRIVILEGES;
