display_errors=Off
display_startup_errors=Off
error_reporting=E_ALL & ~E_DEPRECATED & ~E_STRICT
expose_php=Off
log_errors=On
max_input_time=60
sendmail_path="/usr/sbin/sendmail -t -H 'openssl s_client -quiet -connect ${EMAIL_GATEWAY_HOST}:${EMAIL_GATEWAY_PORT}' -au${EMAIL_GATEWAY_USERNAME} -ap${EMAIL_GATEWAY_PASSWORD} -f ${EMAIL_SENDER_ADDRESS}"
short_open_tag=Off